# Copy to .env and fill in. NEVER commit the filled-in file.
# On Windows:  copy .env.example .env
# setup.ps1 will also restrict the file's permissions to your user only.

# --- brain: Google Gemini (native API) ---------------------------------------
# Get one at https://aistudio.google.com  →  Get API key
GEMINI_API_KEY=
# Chosen at build time. Change freely — it is read at startup, not compiled in.
GEMINI_MODEL=gemini-3.6-flash

# --- voice: ElevenLabs -------------------------------------------------------
# https://elevenlabs.io  →  Profile  →  API key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- offline fallback brain --------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# --- safety switches ---------------------------------------------------------
# 1 = every executor prints what it WOULD do and returns a fake success.
# Leave this on until you have watched JARVIS plan a few things correctly.
JARVIS_DRYRUN=1

# 1 = auto-confirm AMBER and RED without asking. This is a bad idea and the HUD
# prints a warning banner across the top the whole time it is set. It has never
# applied to BLACK and never will.
JARVIS_YOLO=0

# --- paths -------------------------------------------------------------------
# Defaults, chosen at build time because they were not supplied:
#   safe write zone : %USERPROFILE%\JarvisWorkspace
#   index roots     : the safe zone + jarvis/data/demo_vault
# Set these to take the defaults out of play. Windows: separate with ;
JARVIS_SAFE_ZONE=
JARVIS_ROOTS=
JARVIS_EXCLUDE=node_modules;.git;.venv;__pycache__;.obsidian

# NOT USED, and deliberately absent from this codebase:
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, XAI_API_KEY
